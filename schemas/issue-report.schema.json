{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review issue report",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "reviewer", "model", "artifact", "commit", "issues", "verdict"],
  "properties": {
    "gate": { "type": "string", "enum": ["G0", "G1", "G2", "G3", "G4", "G5"] },
    "reviewer": { "type": "string" },
    "model": { "type": "string" },
    "artifact": { "type": "string" },
    "commit": { "type": "string" },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "location", "claim", "evidence", "suggested_fix"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-5]/[a-z0-9-]+/[0-9]+$" },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor"] },
          "location": { "type": "string" },
          "claim": { "type": ["string", "null"] },
          "evidence": { "type": "string" },
          "suggested_fix": { "type": "string" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["accept", "revise"] }
  }
}
