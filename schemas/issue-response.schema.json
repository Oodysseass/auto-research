{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Producer response to a review",
  "type": "object",
  "additionalProperties": false,
  "required": ["producer", "commit", "responses"],
  "properties": {
    "producer": { "type": "string" },
    "commit": { "type": "string" },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "status", "justification"],
        "properties": {
          "issue_id": { "type": "string", "pattern": "^G[0-5]/[a-z0-9-]+/[0-9]+$" },
          "status": { "type": "string", "enum": ["fixed", "rejected", "needs_human"] },
          "justification": { "type": "string" }
        }
      }
    }
  }
}
